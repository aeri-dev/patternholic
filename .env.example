# Copy to .env.local for local development. Never use a VITE_ prefix for secrets.
# Register an OAuth application at https://osu.ppy.sh/home/account/edit#oauth
# Client credentials flow: the callback URL can be left empty.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# On Vercel, set both names in project environment variables and redeploy.
# On Cloudflare, set both with wrangler secret put.
